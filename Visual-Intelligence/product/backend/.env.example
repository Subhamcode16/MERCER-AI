# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=atelier_os

# ── Supabase Auth ─────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── OpenAI (GPT Image 2) ──────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Google Gemini (NB2 + NB Pro) ─────────────────────────────────────────────
GEMINI_API_KEY=...

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=atelier-os-images
R2_PUBLIC_URL=https://images.yourdomain.com
R2_URL_EXPIRY_SECONDS=3600

# ── Razorpay (primary — India) ────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...

# ── Stripe (secondary — international, optional) ──────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── App Config ────────────────────────────────────────────────────────────────
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000

# Routing flags
NB_PRO_BATCH_DEFAULT=true
NB_PRO_MAX_RESOLUTION_STARTER=1024

# Batch worker
BATCH_WORKER_INTERVAL_SECONDS=900

# Provider concurrency limits
OPENAI_MAX_CONCURRENT=5
GEMINI_MAX_CONCURRENT=10
